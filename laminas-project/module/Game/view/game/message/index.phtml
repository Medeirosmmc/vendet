<h1>Messages</h1>

<p>
    <a href="<?php echo $this->url('message', ['action' => 'compose']); ?>">Compose New Message</a>
</p>

<table class="table">
    <tr>
        <th>Subject</th>
        <th>From</th>
        <th>Date</th>
        <th>Actions</th>
    </tr>
    <?php foreach ($this->messages as $message) : ?>
    <tr>
        <td><?php echo $this->escapeHtml($message->asunto); ?></td>
        <td><?php echo $this->escapeHtml($message->remitente); ?></td>
        <td><?php echo $this->escapeHtml($message->fecha_enviado); ?></td>
        <td>
            <a href="<?php echo $this->url('message', ['action' => 'view', 'id' => $message->id_mensaje]); ?>">View</a>
            <a href="<?php echo $this->url('message', ['action' => 'delete', 'id' => $message->id_mensaje]); ?>">Delete</a>
        </td>
    </tr>
    <?php endforeach; ?>
</table>
